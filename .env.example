# Server Port Configuration
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/writeflow_ai?schema=public"

# Redis URL for BullMQ caching and background jobs
REDIS_URL="redis://localhost:6379"

# JWT Authentication Secrets (use long random strings in production)
JWT_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"

# Allowed frontend origin(s) for credentialed CORS (comma-separated for multiple)
CORS_ORIGIN="http://localhost:3000"
